# Worker de reportes (src/worker/config.py). Valores de ejemplo, NO secretos reales.

# --- RabbitMQ ---
# En Dokploy: usuario `archivos-worker` y vhost del entorno al final (ver provision.sh en
# Recome-Notificaciones): amqp://archivos-worker:<clave>@<host-del-broker>:5672/dev
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Se declaran con durable=True y SIN argumentos extra, igual que en
# recome-api-general (RabbitReporteConfig). No agregar argumentos de un solo lado.
QUEUE_REPORTE_GENERAR=reporte.generar
QUEUE_REPORTE_LISTO=reporte.listo
DEAD_LETTER_EXCHANGE=reporte.generar.dead-letter
WORKER_MAX_CONCURRENCIA=10

# --- Base de datos de reportes ---
# OJO: el worker LEE la tabla `anuncio` de api-general por SQL directo (misma base física,
# contrato en recome-api-general/docs/CONTRATO_TABLA_ANUNCIO.md) y ESCRIBE sus tablas
# propias `reporte_autorizacion` y `registro_idempotencia`. Por eso DATABASE_URL debe
# apuntar a la base de api-general (en su compose de Dokploy: base `recome`), con un rol
# de solo lectura sobre `anuncio`. Hoy esa base no es alcanzable desde otros stacks, y
# ninguna migración crea las tablas propias (solo el bootstrap del e2e local).
DATABASE_URL=postgresql://reportes:reportes@localhost:5432/reportes

# --- MinIO ---
# MINIO_ENDPOINT es también el host de la URL firmada (url_descarga) que viaja
# en reporte.listo. recome-api-general la descarga desde su propio proceso para
# adjuntarla al mail, así que debe ser alcanzable DESDE api-general (no solo
# desde este worker).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=cambiar
MINIO_SECRET_KEY=cambiar
MINIO_BUCKET=reportes
MINIO_SECURE=false

# --- Webserver de autenticación (src/webserver/auth_service) ---
JWT_SECRET=cambiar-por-el-secreto-real
